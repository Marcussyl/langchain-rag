# Copy to .env and fill values you need. Blank = use code defaults / feature off.
# CLI and API load .env via settings.py (does not override existing process env).

# --- Ollama (default chat + embeddings) ---
OLLAMA_MODEL=
OLLAMA_EMBED_MODEL=

# --- Chat backend: ollama | gemini | groq | openrouter. Embeddings always use OLLAMA_EMBED_MODEL. ---
CHAT_BACKEND=
# CHAT_BACKEND=ollama
# CHAT_BACKEND=gemini
# CHAT_BACKEND=groq
# CHAT_BACKEND=openrouter
GOOGLE_API_KEY=
GEMINI_MODEL=
# GEMINI_MODEL=gemini-2.0-flash
GROQ_API_KEY=
GROQ_MODEL=
# GROQ_MODEL=llama-3.1-8b-instant
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
# OPENROUTER_MODEL=meta-llama/llama-3.2-3b-instruct:free
OPENROUTER_HTTP_REFERER=
OPENROUTER_APP_TITLE=

# --- Chunking / retrieval ---
RAG_CHUNK_SIZE=
RAG_CHUNK_OVERLAP=
RAG_RETRIEVE_K=
RAG_SEARCH_TYPE=
# Max upload size in bytes (default 5MB)
RAG_MAX_UPLOAD_BYTES=

# --- Checkpointer: blank = Sqlite checkpoints.sqlite ---
# Password with @ must be URL-encoded as %40 in DATABASE_URL.
DATABASE_URL=

# One-shot questions: use CLI -q / --query (do not rely on RAG_QUERY).
RAG_QUERY=
