# Copy to .env if you want overrides (optional — scripts also read os.environ)
OLLAMA_MODEL=llama3.2
OLLAMA_EMBED_MODEL=nomic-embed-text
RAG_CHUNK_SIZE=400
RAG_CHUNK_OVERLAP=80
RAG_RETRIEVE_K=3
RAG_SEARCH_TYPE=similarity
# RAG_SEARCH_TYPE=mmr
# One-shot questions: use CLI flag instead, e.g. uv run python rag.py -q 'What is RAG?'
